<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - DEMO LAB</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand text-danger font-weight-bold" href="#">DEMO LAB</a>
            <div class="navbar-nav">
                <a class="nav-link active" href="#">Trang chủ</a>
                <a class="nav-link" href="#">Giới thiệu</a>
                <a class="nav-link" href="#">Liên hệ</a>
                <a class="nav-link" href="#">Sản phẩm</a>
            </div>
        </div>
    </nav>

    <div class="container my-4">
        <div class="row">
            <div class="col-md-3">
                @await Html.PartialAsync("_CategoryPartial")
            </div>

            <div class="col-md-9">
                @RenderBody()
            </div>
        </div>
    </div>

    <footer class="bg-dark text-white p-4 mt-4">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5>GIỚI THIỆU</h5>
                    <p class="small text-muted">Lorem ipsum dolor sit amet, consectetur adipiscing elit...</p>
                </div>
                <div class="col-md-6">
                    <h5>LIÊN HỆ</h5>
                    <p class="small text-muted">Lorem ipsum dolor sit amet, consectetur adipiscing elit...</p>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>